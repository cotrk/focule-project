{
  "mcpServers": {
    "sequentialthinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.38"
      ]
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-5ad6833e-6b22-4b35-9c82-d097fab481e2"
      },
      "enabled": true
    },
    "vscode": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-vscode"
      ]
    },
    "openwebui": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-openwebui"
      ],
      "env": {
        "OPENWEBUI_API_KEY": "your-openwebui-api-key",
        "OPENWEBUI_URL": "http://localhost:3000"
      }
    },
    "gemini": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gemini"
      ],
      "env": {
        "GEMINI_API_KEY": "your-gemini-api-key"
      }
    }
  }
}
