{
  "name": "focule",
  "version": "1.1.1",
  "description": "Focule - Turn old content into new social content with local transcription and AI.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build": "npm run build:electron && npm run build:icons && vite build && electron-builder",
    "release:win": "npm run build:electron && npm run build:icons && vite build && electron-builder --win nsis",
    "package:win-release": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\scripts\\Assemble-Windows-Release.ps1",
    "package:github-release": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging\\scripts\\Assemble-GitHub-Release.ps1",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:icons": "node scripts/generate-icons.js",
    "preview": "vite preview"
  },
  "keywords": [
    "electron",
    "transcription",
    "whisper",
    "ollama",
    "focule"
  ],
  "author": "Focule",
  "license": "MIT",
  "build": {
    "appId": "com.focule.app",
    "productName": "Focule",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "packaging/runtime/bin",
        "to": "focule-assets/bin"
      },
      {
        "from": "packaging/runtime/whisper",
        "to": "focule-assets/whisper"
      },
      {
        "from": "packaging/licenses",
        "to": "focule-assets/licenses"
      },
      {
        "from": "LICENSE",
        "to": "focule-assets/LICENSE"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.23",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^4.3.5"
  }
}
